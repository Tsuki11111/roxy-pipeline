# ============================================================
# Roxy Pipeline 环境变量示例
# 复制为 .env 后填入真实值；.env 不要提交到 Git。
# ============================================================

# ---------- 模型路由 ----------
# deepseek-flash 作为文本/代码主模型；豆包 Pro 仅备选/A-B
LLM_PROVIDER=deepseek          # deepseek | ark | mock
VISION_PROVIDER=ark            # ark | deepseek | mock | off
TTS_PROVIDER=indextts2         # indextts2（云 TTS 适配器尚未接入）

# ---------- LLM：DeepSeek 官方 ----------
# 已确认 Key 仅开放 deepseek-flash，不要改成其他 DeepSeek 模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- LLM：火山方舟（备选/A-B、视觉） ----------
# 豆包 Pro 只做备选/A-B；视觉模型可选，不作为关键路径
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_STRONG=
ARK_MODEL_VISION=

# ---------- 图像生成：火山方舟 Seedream ----------
# 需在方舟控制台开通；未开通时 IMAGE_PROVIDER=mock 用占位素材
IMAGE_PROVIDER=ark             # ark | mock | openai-compatible
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_SIZE=1080x1920
IMAGE_CANDIDATES=4
ASSET_AGENT_TMP_DIR=./tmp/asset_agent
ASSET_AGENT_AUTO_CHECK=true

# ---------- TTS：本地 IndexTTS2 ----------
# 需要 Python 3.11 独立环境 + NVIDIA GPU；以下为 Windows 本地开发默认路径
TTS_INDEXTTS_PYTHON=./data/tools/indextts-venv/Scripts/python.exe
TTS_INDEXTTS_REPO=./data/tools/IndexTTS2
TTS_INDEXTTS_MODEL_DIR=./data/assets/voice/indextts2/IndexTTS-2
TTS_INDEXTTS_REF_AUDIO=./data/assets/voice/indextts2/reference.wav
TTS_INDEXTTS_URL=http://127.0.0.1:8765
AUDIO_ROOT=./data/audio
VOICE_PAUSE_MS=180
VOICE_AUTO_ALIGN=true
VOICE_AUTO_RENDER=true
TTS_UNLOAD_AFTER_VOICE=true
ALIGN_MODEL_DIR=./data/assets/voice/align/wav2vec2-chinese
ALIGN_DEVICE=cuda
ALIGN_LEVEL=sentence
ALIGN_STOP_TTS=true
QC_AUTO_RUN=true
QC_FRAMES_PER_SHOT=2
QC_VISION_BLOCKING=false
PACKAGE_DIR=./tmp/packages
RECONCILER_STALE_S=1800

# ---------- M6 Remotion 渲染（默认渲染器） ----------
# 需要 Docker；镜像构建见 README「Remotion 渲染（默认）」
REMOTION_ENABLED=true
REMOTION_AUTO_CODEGEN=true
REMOTION_IMAGE=roxy-remotion:4.0.539
REMOTION_VERSION=4.0.539
REMOTION_DOCKER_BIN=docker
REMOTION_WORK_ROOT=./tmp/remotion
REMOTION_CODEGEN_CONCURRENCY=3
REMOTION_CODEGEN_MAX_SHOTS=200
REMOTION_VALIDATE_TIMEOUT_S=300
REMOTION_RENDER_TIMEOUT_S=600
REMOTION_ONLY=true

# ---------- 基础设施（M1.1） ----------
# 本文件是本地模板：API/worker 在宿主机原生运行时用 localhost + 映射端口。
# VM / 容器内运行改用 .env.vm.example（服务名 postgres/rabbitmq/redis/minio）。
ROXY_ENV=local
COMPOSE_PROJECT_NAME=roxy-local
OUTPUT_ROOT=./output
MINIO_UPLOAD_ENABLED=true
MINIO_REQUIRED=false

# 本地无 Docker 时用 SQLite；使用 compose.infra.yml 时改成：
# DATABASE_URL=postgresql+asyncpg://roxy:roxy-dev@localhost:5433/roxy
DATABASE_URL=sqlite+aiosqlite:///./tmp/roxy.db

POSTGRES_USER=roxy
POSTGRES_PASSWORD=roxy-dev
POSTGRES_DB=roxy
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

MINIO_ROOT_USER=roxy
MINIO_ROOT_PASSWORD=roxy-dev
MINIO_INTERNAL_ENDPOINT=http://localhost:9100
MINIO_PUBLIC_ENDPOINT=http://localhost:9100
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET_ASSETS=roxy-assets
MINIO_BUCKET_ARTIFACTS=roxy-artifacts
MINIO_BUCKET_OUTPUT=roxy-output

RABBITMQ_USER=roxy
RABBITMQ_PASSWORD=roxy-dev
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://roxy:roxy-dev@localhost:5673//
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---------- 应用 ----------
APP_ENV=dev
APP_SECRET_KEY=
JWT_SECRET=
LANGGRAPH_CHECKPOINT_SCHEMA=agent_checkpoints
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30

# ---------- M1.2 队列与渲染 ----------
# VM / 容器内运行请用 .env.vm.example，不要把本地 .env 复制过去
CELERY_TASK_ALWAYS_EAGER=false
OUTBOX_POLL_INTERVAL_S=5
RENDER_DIR=./tmp/renders

# ---------- M2 脚本 Agent ----------
SCRIPT_TARGET_CHARS_PER_MINUTE=327
SCRIPT_MAX_REPAIRS=2
SCRIPT_ROXY_RATIO_MIN=0.10
SCRIPT_ROXY_RATIO_MAX=0.30

# ---------- 资产持久化 ----------
# 生成的背景/物件复制到 data/assets；角色包在原目录索引
ASSET_STORAGE=local
ASSET_ROOT=./data/assets

# ---------- 可选：观测 ----------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
