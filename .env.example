# ============================================================
# Roxy Pipeline 环境变量示例
# 复制为 .env 后填入真实值；.env 不要提交到 Git。
# ============================================================

# ---------- 模型路由 ----------
# deepseek-flash 作为文本/代码主模型；豆包 Pro 仅备选/A-B
LLM_PROVIDER=deepseek          # deepseek | ark | mock
VISION_PROVIDER=ark            # ark | deepseek | mock | off
TTS_PROVIDER=volcengine        # volcengine | minimax | mock

# ---------- LLM：DeepSeek 官方 ----------
# 已确认 Key 仅开放 deepseek-flash，不要改成其他 DeepSeek 模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- LLM：火山方舟（备选/A-B、视觉） ----------
# 豆包 Pro 只做备选/A-B；视觉模型可选，不作为关键路径
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_STRONG=
ARK_MODEL_VISION=

# ---------- 图像生成：火山方舟 Seedream ----------
# 需在方舟控制台开通；未开通时 IMAGE_PROVIDER=mock 用占位素材
IMAGE_PROVIDER=ark             # ark | mock | openai-compatible
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_SIZE=1080x1920
IMAGE_CANDIDATES=4

# ---------- TTS：火山语音（与方舟 Key 不是同一套凭据） ----------
# 若最终改用 MiniMax / 阿里云，可换成对应变量，不必填这几项
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
TTS_VOICE_NARRATOR=
TTS_VOICE_ROXY=

# ---------- 基础设施 ----------
POSTGRES_USER=roxy
POSTGRES_PASSWORD=
POSTGRES_DB=roxy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9100
MINIO_BUCKET_ASSETS=roxy-assets
MINIO_BUCKET_ARTIFACTS=roxy-artifacts
MINIO_BUCKET_OUTPUT=roxy-output

RABBITMQ_URL=amqp://roxy:change-me@rabbitmq:5672//
REDIS_URL=redis://redis:6379/0

# ---------- 应用 ----------
APP_ENV=dev
APP_SECRET_KEY=
JWT_SECRET=
LANGGRAPH_CHECKPOINT_SCHEMA=agent_checkpoints
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30

# ---------- 可选：观测 ----------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
