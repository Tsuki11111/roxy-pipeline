# ============================================================
# Roxy Pipeline · VM / 容器部署环境模板
# 复制为 .env 放在 VM 上；不要和本地 .env 混用或互相复制。
# 容器内通过 compose 服务名互相访问（postgres/rabbitmq/redis/minio），
# 宿主机上原生进程则用 localhost + 映射端口。
# ============================================================

ROXY_ENV=vm
COMPOSE_PROJECT_NAME=roxy-vm

# ---------- 模型路由 ----------
LLM_PROVIDER=deepseek          # deepseek | ark | mock
VISION_PROVIDER=ark            # ark | deepseek | mock | off
TTS_PROVIDER=volcengine        # volcengine | minimax | mock

# ---------- LLM：DeepSeek 官方 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- LLM：火山方舟（备选/A-B、视觉） ----------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_STRONG=
ARK_MODEL_VISION=

# ---------- 图像生成：火山方舟 Seedream ----------
IMAGE_PROVIDER=ark             # ark | mock | openai-compatible
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
IMAGE_SIZE=1080x1920
IMAGE_CANDIDATES=4

# ---------- TTS：火山语音 ----------
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
TTS_VOICE_NARRATOR=
TTS_VOICE_ROXY=

# ---------- 基础设施（容器内地址） ----------
# 容器内 API/worker 用服务名；若在 VM 宿主机原生跑进程，改成 localhost:5433/5673/6380。
DATABASE_URL=postgresql+asyncpg://roxy:roxy-dev@postgres:5432/roxy

POSTGRES_USER=roxy
POSTGRES_PASSWORD=roxy-dev
POSTGRES_DB=roxy
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

MINIO_ROOT_USER=roxy
MINIO_ROOT_PASSWORD=roxy-dev
MINIO_INTERNAL_ENDPOINT=http://minio:9000
# 浏览器可访问的 MinIO 地址；按 VM 域名 / 反向代理填写
MINIO_PUBLIC_ENDPOINT=
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET_ASSETS=roxy-assets
MINIO_BUCKET_ARTIFACTS=roxy-artifacts
MINIO_BUCKET_OUTPUT=roxy-output

RABBITMQ_USER=roxy
RABBITMQ_PASSWORD=roxy-dev
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_URL=amqp://roxy:roxy-dev@rabbitmq:5672//
REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0

# ---------- 应用 ----------
APP_ENV=prod
APP_SECRET_KEY=
JWT_SECRET=
LANGGRAPH_CHECKPOINT_SCHEMA=agent_checkpoints
LANGGRAPH_CHECKPOINT_RETENTION_DAYS=30

# ---------- M1.2 队列与渲染 ----------
CELERY_TASK_ALWAYS_EAGER=false
OUTBOX_POLL_INTERVAL_S=5
RENDER_DIR=./tmp/renders

# ---------- M2 脚本 Agent ----------
SCRIPT_TARGET_CHARS_PER_MINUTE=327
SCRIPT_MAX_REPAIRS=2
SCRIPT_ROXY_RATIO_MIN=0.10
SCRIPT_ROXY_RATIO_MAX=0.30

# ---------- 资产持久化 ----------
# VM 数据盘挂 /data；角色包在原目录索引
ASSET_STORAGE=local
ASSET_ROOT=/data/assets
